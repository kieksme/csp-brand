{
  "name": "csp-example-service",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "files": [
    "dist"
  ],
  "exports": {
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsup src/browser.tsx src/server.ts --format esm --dts --clean --external @kieksme/csp-sdk --external react --external react-dom",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm build"
  },
  "dependencies": {
    "@kieksme/csp-sdk": "0.13.4",
    "zod": "3.25.76"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "react": "19.3.0",
    "tsup": "8.5.1",
    "typescript": "5.9.3"
  },
  "cspPlugin": {
    "id": "example-service",
    "sdkVersion": "^0.13.4",
    "requires": [],
    "browser": "./browser",
    "server": "./server"
  }
}
