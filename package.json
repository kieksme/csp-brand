{
  "name": "@kieksme/csp-brand",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm build:ui && astro dev --host 127.0.0.1",
    "build": "pnpm build:storybook && astro build && node scripts/include-storybook.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "typecheck": "astro check",
    "lint": "prettier --check .",
    "format": "prettier --write .",
    "test": "node --test tests/*.test.mjs && pnpm test:ui",
    "test:browser": "playwright test",
    "assets": "node scripts/export-assets.mjs",
    "check": "pnpm build:ui && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "test:skills": "node scripts/verify-skills.mjs",
    "build:ui": "pnpm --filter @kieksme/csp-ui build",
    "pack:ui": "node scripts/pack-ui.mjs",
    "test:ui": "node --import tsx --test test/unit/components/*.test.tsx",
    "storybook": "pnpm build:ui && pnpm pack:ui && storybook dev -p 6006 --host 127.0.0.1 --disable-telemetry",
    "build:storybook": "pnpm build:ui && pnpm pack:ui && storybook build --disable-telemetry --output-dir storybook-static",
    "test:storybook": "pnpm build:ui && pnpm pack:ui && vitest run --config vitest.storybook.config.ts"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/inter": "5.3.0",
    "@kieksme/csp-ui": "workspace:*",
    "astro": "7.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-vitest": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/jsdom": "30.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/browser-playwright": "4.1.11",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "sharp": "0.35.5",
    "storybook": "10.6.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "4.1.11"
  }
}
