---
import {
  Activity,
  ArrowDownLeft,
  ArrowLeftRight,
  ArrowRight,
  ArrowUpRight,
  Blocks,
  Check,
  Clock3,
  CodeXml,
  CornerDownRight,
  FileText,
  Hash,
  Infinity as InfinityIcon,
  Menu,
  MessagesSquare,
  Phone,
  Plus,
  Send,
  Users,
} from "@lucide/astro";

const icons = {
  contact: Phone,
  signl4: Clock3,
  kuma: Activity,
  content: FileText,
  chat: MessagesSquare,
  teams: Users,
  slack: Hash,
  telegram: Send,
  module: Blocks,
  arrow: ArrowRight,
  "arrow-up-right": ArrowUpRight,
  "arrow-down-left": ArrowDownLeft,
  "arrow-left-right": ArrowLeftRight,
  "corner-down-right": CornerDownRight,
  check: Check,
  menu: Menu,
  plus: Plus,
  infinity: InfinityIcon,
  code: CodeXml,
};
interface Props {
  name?: keyof typeof icons;
  size?: number;
}
const { name = "module", size = 24 } = Astro.props;
const Symbol = icons[name];
---

<Symbol
  class="icon"
  size={size}
  stroke-width={1.6}
  aria-hidden="true"
  focusable="false"
/>
