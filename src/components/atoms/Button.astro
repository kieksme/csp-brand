---
import { LinkButton } from "@kieksme/csp-ui";
interface Props {
  href: string;
  variant?: "primary" | "secondary" | "light";
  arrow?: boolean;
}
const { href, variant = "primary", arrow = true } = Astro.props;
---

<LinkButton href={href} variant={variant} hasArrow={arrow}>
  <slot />
</LinkButton>
