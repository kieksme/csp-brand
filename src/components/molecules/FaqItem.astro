---
import Icon from "../atoms/Icon.astro";
interface Props {
  question: string;
  answer: string;
}
const { question, answer } = Astro.props;
---

<details class="faq-item">
  <summary>
    {question}
    <span aria-hidden="true">
      <Icon name="plus" size={20} />
    </span>
  </summary>
  <p>{answer}</p>
</details>
