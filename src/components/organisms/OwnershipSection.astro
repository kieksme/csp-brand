---
import SectionHeading from "../molecules/SectionHeading.astro";
import BenefitCard from "../molecules/BenefitCard.astro";
import type { Locale } from "../../lib/paths";
import { text } from "../../data/copy";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = text(locale).ownership;
---

<section class="section ownership">
  <div class="container">
    <SectionHeading eyebrow={t.eyebrow} title={t.title} description={t.intro} />
    <div class="benefit-grid">
      {t.cards.map((item, i) => (
        <BenefitCard
          {...item}
          icon={
            ["arrow-up-right", "check", "infinity"][i] as
              "arrow-up-right" | "check" | "infinity"
          }
        />
      ))}
    </div>
    <p class="cost-note">{t.cost}</p>
  </div>
</section>
