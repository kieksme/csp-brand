---
import Icon from "../atoms/Icon.astro";
import SectionHeading from "../molecules/SectionHeading.astro";
import Button from "../atoms/Button.astro";
import { contactUrl } from "../../lib/paths";
import type { Locale } from "../../lib/paths";
import { text } from "../../data/copy";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = text(locale);
---

<section id="contact" class="contact-section">
  <div class="container contact-grid">
    <SectionHeading
      eyebrow={t.cta.eyebrow}
      title={t.cta.title}
      description={t.cta.text}
    />
    <div>
      <Button href={contactUrl(locale)} variant="light">
        {t.contact}
      </Button>
      <a class="contact-mail" href="mailto:kontakt@kieks.me">
        kontakt@kieks.me
      </a>
    </div>
  </div>
  <span class="contact-mark" aria-hidden="true">
    <Icon name="arrow-up-right" size={480} />
  </span>
</section>
