# Optional build / SEO configuration. Copy to .env for local overrides.
# Placeholders stay open until product decisions (E1–E6, E11) are confirmed.

# TODO: ⟦PLATZHALTER: Domain⟧ (E1) — single indexed origin for Netlify / sitemap.
# CSP_BRAND_SITE_URL=https://csp.example

# TODO: ⟦PLATZHALTER: Domain⟧ (E1/E2) — on non-canonical hosts (e.g. GitHub Pages),
# point canonical/hreflang at the indexed origin. Triggers auto-noindex when it
# differs from CSP_BRAND_SITE_URL / the build site.
# CSP_BRAND_CANONICAL_URL=https://csp.example

# TODO: ⟦PLATZHALTER: Host indexing⟧ (E2) — force noindex on this build.
# CSP_BRAND_NOINDEX=true

# Deploy base path (Netlify uses /; GitHub Pages defaults to /csp-brand).
# CSP_BRAND_BASE_PATH=/

# TODO: ⟦PLATZHALTER: Buchungs-URL⟧ (E3) — booking tool link (no embed). Empty =
# mailto-only primary CTAs and no BOOKING_CLICK matching.
# CSP_BRAND_BOOKING_URL=https://example.com/book

# TODO: ⟦PLATZHALTER: Domain⟧ (E1) — Swetrix marketing hostname allowlist entry.
# CSP_BRAND_MARKETING_HOST=csp.example

# TODO: ⟦PLATZHALTER: Ort laut Impressum⟧ (E6) — Organization JSON-LD locality.
# CSP_BRAND_ORG_LOCALITY=

# TODO: ⟦PLATZHALTER: Logo-URL⟧ — absolute PNG ≥112×112; defaults to apple-touch-icon.
# CSP_BRAND_ORG_LOGO_URL=
